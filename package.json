{
  "name": "ai-memory-organizer",
  "version": "1.0.0",
  "private": true,
  "description": "AI Memory Organizer - Express + MongoDB (Mongoose) backend with JWT auth, CRUD, indexing and aggregation pipelines",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "seed": "node seed.js",
    "migrate": "node scripts/migrate.js",
    "explain": "node scripts/explain.js",
    "report:queries": "node scripts/report-queries.js",
    "report:api": "node scripts/report-api-samples.js",
    "test": "jest --runInBand",
    "worker": "node scripts/worker.js",
    "test:live": "node scripts/live-smoke.js",
    "llm:costs": "node scripts/llm-costs.js",
    "data:download": "node scripts/datasets/download.js",
    "data:load:locomo": "node scripts/datasets/load-locomo.js",
    "data:load:longmemeval": "node scripts/datasets/load-longmemeval.js",
    "data:synthetic": "node scripts/datasets/generate-synthetic.js",
    "data:stats": "node scripts/datasets/stats.js",
    "data:stats:longmemeval": "node scripts/datasets/longmemeval-stats.js",
    "embed:backfill": "node scripts/embed-backfill.js",
    "atlas:index": "node scripts/atlas-index.js",
    "bench:retrieval": "node scripts/bench-retrieval.js",
    "bench:indexes": "node eval/bench-indexes.js",
    "eval": "node eval/run.js",
    "eval:cost": "node eval/project-cost.js",
    "eval:judge-agreement": "node eval/judge-agreement.js",
    "eval:pool": "node eval/pool.js",
    "eval:preflight": "node eval/preflight.js",
    "eval:batch": "node eval/run-batch.js",
    "eval:status": "node eval/status.js",
    "eval:retry": "node eval/retry-failed.js",
    "eval:token-fit": "node eval/token-fit.js",
    "eval:launch-retry": "node eval/launch-retry.js",
    "eval:lme-diagnostics": "node eval/lme-diagnostics.js",
    "eval:retry-status": "node eval/retry-status.js",
    "eval:launch": "node eval/launch.js",
    "erasure:verify": "node scripts/verify-erasure.js",
    "retention": "node scripts/retention.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mongodb",
    "mongoose",
    "express",
    "dbms"
  ],
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testTimeout": 20000,
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
