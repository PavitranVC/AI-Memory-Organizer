{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(docker *)",
      "Bash(dockerd *)",
      "Bash(mongosh *)",
      "Bash(curl -sS *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(ollama *)",
      "Bash(gh pr *)",
      "Bash(gh run *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Context was just compacted. Re-read CLAUDE.md and docs/OVERNIGHT_REPORT.md before continuing.\"; echo \"Branch: $(git branch --show-current)\"; git log --oneline -5; if [ -f docs/OVERNIGHT_REPORT.md ]; then tail -n 30 docs/OVERNIGHT_REPORT.md; fi",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
