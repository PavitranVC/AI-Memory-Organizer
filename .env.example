# MongoDB connection used by the app, the seed and the scripts.
# Since Stage 2 MongoDB must run as a replica set (a single node is fine) because changes use transactions.
# The URI stays the same; see "Run MongoDB as a replica set" in the README.
MONGO_URI=mongodb://127.0.0.1:27017/aimemory
# A separate database for "npm test". The tests DROP this database, so never point it at real data.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/aimemory_test

PORT=5000

# Secret used to sign login tokens. Use a long random value (for example: openssl rand -hex 32).
# Required when NODE_ENV=production. In development an insecure default is used with a warning.
JWT_SECRET=change-me
# How long a login token stays valid (a number of seconds, or a string like 7d)
JWT_EXPIRES_IN=7d
# bcrypt cost factor for password hashing (10 is a sensible default)
BCRYPT_ROUNDS=10

# Password given to every user created by "npm run seed". Development only.
SEED_PASSWORD=DevPassword123
# Optional: used by "npm run migrate" to give old users that have no password one
# MIGRATE_DEFAULT_PASSWORD=

# --- Stage 3: LLM extraction ---
# Which LLM answers: "mock" (default, deterministic, free, used by all tests) or "anthropic" (real API, costs money)
LLM_PROVIDER=mock
# Needed only for LLM_PROVIDER=anthropic and "npm run test:live". Keep it in .env, which is never committed.
# ANTHROPIC_API_KEY=
# Models per task (default claude-opus-5-5). JUDGE_MODEL is used by the Stage 6 evaluation.
EXTRACTION_MODEL=claude-opus-5-5
RECONCILE_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
# How hard the model thinks: low | medium | high | xhigh | max (higher = better but more output tokens)
LLM_EFFORT=medium
# "default": if a safety classifier declines, the API retries on a fallback model; "off" disables that
LLM_FALLBACKS=default
# Queue an extraction job for every new user message (set to false to switch the pipeline off)
EXTRACTION_ENABLED=true
# How many earlier messages are sent to the extractor as context (never the whole conversation)
EXTRACTION_CONTEXT_MESSAGES=6
# Run the extraction worker inside "npm start" (handy for a demo). Otherwise run "npm run worker" separately.
WORKER_IN_PROCESS=false
# Worker tuning: poll interval when idle, first retry delay (doubles each attempt), lock timeout for a dead worker
WORKER_POLL_MS=2000
JOB_RETRY_DELAY_MS=5000
JOB_LOCK_TIMEOUT_MS=300000
# Database used (and DROPPED) by "npm run test:live"
MONGO_URI_LIVE=mongodb://127.0.0.1:27017/aimemory_live
